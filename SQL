CREATE OR REPLACE FUNCTION get_employee_bonus(
    p_emp_id INT,
    OUT o_full_name VARCHAR,
    OUT o_bonus NUMERIC
)
    LANGUAGE plpgsql
AS $$
DECLARE
    v_salary NUMERIC;
    v_rating VARCHAR(10);
BEGIN

    SELECT full_name, salary, performance_rating
    INTO o_full_name, v_salary, v_rating
    FROM employees
    WHERE emp_id = p_emp_id;

    IF NOT FOUND THEN
        o_full_name := 'NOT_FOUND';
        o_bonus := 0;
        RETURN;
    END IF;
    IF v_rating = 'A' THEN
        o_bonus := v_salary * 1.5;
    ELSIF v_rating = 'B' THEN
        o_bonus := v_salary * 1.0;
    ELSE
        o_bonus := v_salary * 0.5;
    END IF;
END;
$$;
